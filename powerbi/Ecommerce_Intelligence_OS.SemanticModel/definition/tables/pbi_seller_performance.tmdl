table pbi_seller_performance

	measure 'Summary Seller Weighted Late Rate %' = DIVIDE(SUMX(pbi_seller_performance, (pbi_seller_performance[late_delivery_rate_pct] / 100.0) * pbi_seller_performance[delivered_orders]), SUM(pbi_seller_performance[delivered_orders]), 0)
		formatString: 0.00%
		displayFolder: 03 Product & Seller

	measure 'Summary Seller Weighted Review Score' = DIVIDE(SUMX(pbi_seller_performance, pbi_seller_performance[avg_review_score] * pbi_seller_performance[delivered_orders]), SUM(pbi_seller_performance[delivered_orders]), 0)
		formatString: 0.00
		displayFolder: 03 Product & Seller

	column seller_id
		dataType: string
		sourceColumn: seller_id

	column seller_state
		dataType: string
		sourceColumn: seller_state

	column seller_city
		dataType: string
		sourceColumn: seller_city

	column delivered_orders
		dataType: int64
		sourceColumn: delivered_orders

	column items_sold
		dataType: int64
		sourceColumn: items_sold

	column distinct_products
		dataType: int64
		sourceColumn: distinct_products

	column item_revenue_brl
		dataType: double
		formatString: "R$" #,##0.00
		sourceColumn: item_revenue_brl

	column freight_value_brl
		dataType: double
		formatString: "R$" #,##0.00
		sourceColumn: freight_value_brl

	column avg_item_price_brl
		dataType: double
		formatString: "R$" #,##0.00
		sourceColumn: avg_item_price_brl

	column avg_delivery_days
		dataType: double
		formatString: 0.00
		sourceColumn: avg_delivery_days

	column late_delivery_rate_pct
		dataType: double
		formatString: 0.00"%"
		sourceColumn: late_delivery_rate_pct

	column avg_review_score
		dataType: double
		formatString: 0.00
		sourceColumn: avg_review_score

	partition pbi_seller_performance = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\Dell\OneDrive\Desktop\Documents\DataAnalyticsPortfolio\ecommerce-revenue-retention-intelligence\powerbi\data_exports\pbi_seller_performance.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted,{{"seller_id", type text}, {"seller_state", type text}, {"seller_city", type text}, {"delivered_orders", Int64.Type}, {"items_sold", Int64.Type}, {"distinct_products", Int64.Type}, {"item_revenue_brl", type number}, {"freight_value_brl", type number}, {"avg_item_price_brl", type number}, {"avg_delivery_days", type number}, {"late_delivery_rate_pct", type number}, {"avg_review_score", type number}}, "en-US")
				in
				    Typed

