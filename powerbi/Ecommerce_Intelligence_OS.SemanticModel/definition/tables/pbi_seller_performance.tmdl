table pbi_seller_performance
	lineageTag: fa8abef7-8b48-4af4-92a8-212664141efd

	measure 'Summary Seller Weighted Late Rate %' = DIVIDE(SUMX(pbi_seller_performance, (pbi_seller_performance[late_delivery_rate_pct] / 100.0) * pbi_seller_performance[delivered_orders]), SUM(pbi_seller_performance[delivered_orders]), 0)
		formatString: 0.00%
		displayFolder: 03 Product & Seller
		lineageTag: efb3b7e8-41d6-46f6-b03f-0410be58f384

	measure 'Summary Seller Weighted Review Score' = DIVIDE(SUMX(pbi_seller_performance, pbi_seller_performance[avg_review_score] * pbi_seller_performance[delivered_orders]), SUM(pbi_seller_performance[delivered_orders]), 0)
		formatString: 0.00
		displayFolder: 03 Product & Seller
		lineageTag: 4e52f3d7-80fa-4866-bbf7-2181bf715d9e

