table pbi_state_performance
	lineageTag: 60954914-2000-4e61-ab72-fd74063bf51e

	measure 'Summary State Weighted Delivery Days' = DIVIDE(SUMX(pbi_state_performance, pbi_state_performance[avg_delivery_days] * pbi_state_performance[delivered_orders]), SUM(pbi_state_performance[delivered_orders]), 0)
		formatString: 0.00
		displayFolder: 04 Delivery & CX
		lineageTag: 256277f3-ae1f-4214-915b-800f5be98880

	measure 'Summary State Weighted Late Rate %' = DIVIDE(SUMX(pbi_state_performance, (pbi_state_performance[late_delivery_rate_pct] / 100.0) * pbi_state_performance[delivered_orders]), SUM(pbi_state_performance[delivered_orders]), 0)
		formatString: 0.00%
		displayFolder: 04 Delivery & CX
		lineageTag: 322c1caa-f590-4151-b371-ff234674a183

	measure 'Summary State Weighted Review Score' = DIVIDE(SUMX(pbi_state_performance, pbi_state_performance[avg_review_score] * pbi_state_performance[delivered_orders]), SUM(pbi_state_performance[delivered_orders]), 0)
		formatString: 0.00
		displayFolder: 04 Delivery & CX
		lineageTag: 087284a8-5890-4f9c-93fe-21e7c15e17eb

