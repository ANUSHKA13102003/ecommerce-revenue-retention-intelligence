table pbi_rfm_segments_summary

	measure 'RFM Customers Count' = SUM(pbi_rfm_segments_summary[customer_count])
		formatString: #,##0
		displayFolder: 02 Customer & Retention

	measure 'RFM Total Order Value Proxy (BRL)' = SUM(pbi_rfm_segments_summary[total_order_value_brl])
		formatString: "R$" #,##0.00
		displayFolder: 02 Customer & Retention

	measure 'RFM Weighted Avg Monetary (BRL)' = DIVIDE(SUM(pbi_rfm_segments_summary[total_order_value_brl]), SUM(pbi_rfm_segments_summary[customer_count]), 0)
		formatString: "R$" #,##0.00
		displayFolder: 02 Customer & Retention

	column customer_segment
		dataType: string
		sourceColumn: customer_segment

	column customer_count
		dataType: int64
		sourceColumn: customer_count

	column customer_share_pct
		dataType: double
		formatString: 0.00"%"
		sourceColumn: customer_share_pct

	column avg_recency_days
		dataType: double
		formatString: 0.00
		sourceColumn: avg_recency_days

	column avg_purchase_days
		dataType: double
		formatString: 0.00
		sourceColumn: avg_purchase_days

	column avg_monetary_brl
		dataType: double
		formatString: "R$" #,##0.00
		sourceColumn: avg_monetary_brl

	column total_order_value_brl
		dataType: double
		formatString: "R$" #,##0.00
		sourceColumn: total_order_value_brl

	column revenue_share_pct
		dataType: double
		formatString: 0.00"%"
		sourceColumn: revenue_share_pct

	partition pbi_rfm_segments_summary = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\Dell\OneDrive\Desktop\Documents\DataAnalyticsPortfolio\ecommerce-revenue-retention-intelligence\powerbi\data_exports\pbi_rfm_segments_summary.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted,{{"customer_segment", type text}, {"customer_count", Int64.Type}, {"customer_share_pct", type number}, {"avg_recency_days", type number}, {"avg_purchase_days", type number}, {"avg_monetary_brl", type number}, {"total_order_value_brl", type number}, {"revenue_share_pct", type number}}, "en-US")
				in
				    Typed

