table pbi_cohort_retention_matrix

	column cohort_month
		dataType: string
		sourceColumn: cohort_month

	column cohort_start_date
		dataType: dateTime
		formatString: yyyy-MM-dd
		sourceColumn: cohort_start_date

	column cohort_size
		dataType: int64
		sourceColumn: cohort_size

	column m0_pct
