	partition pbi_cohort_retention_matrix = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\Dell\OneDrive\Desktop\Documents\DataAnalyticsPortfolio\ecommerce-revenue-retention-intelligence\powerbi\data_exports\pbi_cohort_retention_matrix.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted,{{"cohort_month", type text}, {"cohort_start_date", type date}, {"cohort_size", Int64.Type}, {"m0_pct", type number}, {"m1_pct", type number}, {"m2_pct", type number}, {"m3_pct", type number}, {"m4_pct", type number}, {"m5_pct", type number}, {"m6_pct", type number}, {"m7_pct", type number}, {"m8_pct", type number}, {"m9_pct", type number}, {"m10_pct", type number}, {"m11_pct", type number}, {"m12_pct", type number}}, "en-US")
