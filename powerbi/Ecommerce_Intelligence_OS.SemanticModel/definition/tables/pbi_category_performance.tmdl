table pbi_category_performance
	lineageTag: b683dd9b-6dc5-4e0f-8066-56b5be9197f5

	measure 'Summary Category Weighted Review Score' = DIVIDE(SUMX(pbi_category_performance, pbi_category_performance[avg_review_score] * pbi_category_performance[delivered_orders]), SUM(pbi_category_performance[delivered_orders]), 0)
		formatString: 0.00
		displayFolder: 03 Product & Seller
		lineageTag: a9564928-d67c-4110-9e46-932b120a072e

