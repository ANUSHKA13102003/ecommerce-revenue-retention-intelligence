	partition pbi_category_performance = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\Dell\OneDrive\Desktop\Documents\DataAnalyticsPortfolio\ecommerce-revenue-retention-intelligence\powerbi\data_exports\pbi_category_performance.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted,{{"category_name_en", type text}, {"category_name_pt", type text}, {"delivered_orders", Int64.Type}, {"items_sold", Int64.Type}, {"distinct_products", Int64.Type}, {"distinct_sellers", Int64.Type}, {"item_revenue_brl", type number}, {"freight_value_brl", type number}, {"avg_item_price_brl", type number}, {"avg_delivery_days", type number}, {"late_delivery_rate_pct", type number}, {"avg_review_score", type number}}, "en-US")
				in
				    Typed

