table pbi_category_performance

	measure 'Summary Category Weighted Review Score' = DIVIDE(SUMX(pbi_category_performance, pbi_category_performance[avg_review_score] * pbi_category_performance[delivered_orders]), SUM(pbi_category_performance[delivered_orders]), 0)
		formatString: 0.00
		displayFolder: 03 Product & Seller

	column category_name_en
		dataType: string
		sourceColumn: category_name_en

	column category_name_pt
		dataType: string
		sourceColumn: category_name_pt

	column delivered_orders
		dataType: int64
		sourceColumn: delivered_orders

	column items_sold
		dataType: int64
		sourceColumn: items_sold

	column distinct_products
		dataType: int64
		sourceColumn: distinct_products

	column distinct_sellers
		dataType: int64
		sourceColumn: distinct_sellers

	column item_revenue_brl
		dataType: double
		formatString: "R$" #,##0.00
		sourceColumn: item_revenue_brl

	column freight_value_brl
		dataType: double
		formatString: "R$" #,##0.00
		sourceColumn: freight_value_brl

	column avg_item_price_brl
		dataType: double
		formatString: "R$" #,##0.00
		sourceColumn: avg_item_price_brl

	column avg_delivery_days
		dataType: double
		formatString: 0.00
		sourceColumn: avg_delivery_days

	column late_delivery_rate_pct
		dataType: double
		formatString: 0.00"%"
		sourceColumn: late_delivery_rate_pct

	column avg_review_score
		dataType: double
		formatString: 0.00
		sourceColumn: avg_review_score

	partition pbi_category_performance = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\Dell\OneDrive\Desktop\Documents\DataAnalyticsPortfolio\ecommerce-revenue-retention-intelligence\powerbi\data_exports\pbi_category_performance.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted,{{"category_name_en", type text}, {"category_name_pt", type text}, {"delivered_orders", Int64.Type}, {"items_sold", Int64.Type}, {"distinct_products", Int64.Type}, {"distinct_sellers", Int64.Type}, {"item_revenue_brl", type number}, {"freight_value_brl", type number}, {"avg_item_price_brl", type number}, {"avg_delivery_days", type number}, {"late_delivery_rate_pct", type number}, {"avg_review_score", type number}}, "en-US")
				in
				    Typed

