	partition pbi_payment_methods = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\Dell\OneDrive\Desktop\Documents\DataAnalyticsPortfolio\ecommerce-revenue-retention-intelligence\powerbi\data_exports\pbi_payment_methods.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
