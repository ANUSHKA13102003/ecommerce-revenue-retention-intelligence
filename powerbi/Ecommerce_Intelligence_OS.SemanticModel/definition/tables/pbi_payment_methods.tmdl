table pbi_payment_methods

	column payment_type
		dataType: string
		sourceColumn: payment_type

	column transaction_count
		dataType: int64
		sourceColumn: transaction_count

	column delivered_orders
		dataType: int64
		sourceColumn: delivered_orders

	column total_payment_value_brl
		dataType: double
		formatString: "R$" #,##0.00
		sourceColumn: total_payment_value_brl

	column avg_transaction_value_brl
		dataType: double
		formatString: "R$" #,##0.00
		sourceColumn: avg_transaction_value_brl

	column avg_installments
		dataType: double
		formatString: 0.00
		sourceColumn: avg_installments

	partition pbi_payment_methods = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\Dell\OneDrive\Desktop\Documents\DataAnalyticsPortfolio\ecommerce-revenue-retention-intelligence\powerbi\data_exports\pbi_payment_methods.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted,{{"payment_type", type text}, {"transaction_count", Int64.Type}, {"delivered_orders", Int64.Type}, {"total_payment_value_brl", type number}, {"avg_transaction_value_brl", type number}, {"avg_installments", type number}}, "en-US")
				in
				    Typed

