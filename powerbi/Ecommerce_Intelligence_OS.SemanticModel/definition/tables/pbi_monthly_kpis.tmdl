table pbi_monthly_kpis

	column sales_month
		dataType: string
		sourceColumn: sales_month

	column month_start_date
		dataType: dateTime
		formatString: yyyy-MM-dd
		sourceColumn: month_start_date

	column delivered_orders
		dataType: int64
		sourceColumn: delivered_orders

	column active_customers
		dataType: int64
		sourceColumn: active_customers

	column order_value_proxy_brl
		dataType: double
		formatString: "R$" #,##0.00
		sourceColumn: order_value_proxy_brl

	column item_revenue_brl
		dataType: double
		formatString: "R$" #,##0.00
		sourceColumn: item_revenue_brl

	column freight_value_brl
		dataType: double
		formatString: "R$" #,##0.00
		sourceColumn: freight_value_brl

	column average_order_value_brl
		dataType: double
		formatString: "R$" #,##0.00
		sourceColumn: average_order_value_brl

	column prev_month_order_value_brl
		dataType: double
		formatString: "R$" #,##0.00
		sourceColumn: prev_month_order_value_brl

	column mom_growth_pct
		dataType: double
		formatString: 0.00"%"
		sourceColumn: mom_growth_pct

	column avg_delivery_days
		dataType: double
		formatString: 0.00
		sourceColumn: avg_delivery_days

	column late_delivery_rate_pct
		dataType: double
		formatString: 0.00"%"
		sourceColumn: late_delivery_rate_pct

	column avg_review_score
		dataType: double
		formatString: 0.00
		sourceColumn: avg_review_score

	partition pbi_monthly_kpis = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\Dell\OneDrive\Desktop\Documents\DataAnalyticsPortfolio\ecommerce-revenue-retention-intelligence\powerbi\data_exports\pbi_monthly_kpis.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted,{{"sales_month", type text}, {"month_start_date", type date}, {"delivered_orders", Int64.Type}, {"active_customers", Int64.Type}, {"order_value_proxy_brl", type number}, {"item_revenue_brl", type number}, {"freight_value_brl", type number}, {"average_order_value_brl", type number}, {"prev_month_order_value_brl", type number}, {"mom_growth_pct", type number}, {"avg_delivery_days", type number}, {"late_delivery_rate_pct", type number}, {"avg_review_score", type number}}, "en-US")
				in
				    Typed

