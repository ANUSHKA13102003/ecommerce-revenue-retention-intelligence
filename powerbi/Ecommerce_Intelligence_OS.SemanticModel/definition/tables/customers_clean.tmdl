table customers_clean

	column customer_id
		dataType: string
		isKey
		sourceColumn: customer_id

	column customer_unique_id
		dataType: string
		sourceColumn: customer_unique_id

	column customer_zip_code_prefix
		dataType: string
		sourceColumn: customer_zip_code_prefix

	column customer_city
		dataType: string
		sourceColumn: customer_city

	column customer_state
		dataType: string
		sourceColumn: customer_state

	column customer_city_normalized
		dataType: string
		sourceColumn: customer_city_normalized

	partition customers_clean = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\Dell\OneDrive\Desktop\Documents\DataAnalyticsPortfolio\ecommerce-revenue-retention-intelligence\data\processed\customers_clean.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted,{{"customer_id", type text}, {"customer_unique_id", type text}, {"customer_zip_code_prefix", type text}, {"customer_city", type text}, {"customer_state", type text}, {"customer_city_normalized", type text}}, "en-US")
				in
				    Typed

