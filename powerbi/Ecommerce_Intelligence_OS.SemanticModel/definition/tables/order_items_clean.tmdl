table order_items_clean

	/// Approved Rule D-1: SUM(price) for product, category, and seller performance.
	measure 'Delivered Item Revenue (BRL)' = CALCULATE(SUM(order_items_clean[price]), order_level[is_delivered] = TRUE())
		formatString: "R$" #,##0.00
		displayFolder: 01 Revenue & Orders

	measure 'Delivered Freight Value (BRL)' = CALCULATE(SUM(order_items_clean[freight_value]), order_level[is_delivered] = TRUE())
		formatString: "R$" #,##0.00
		displayFolder: 01 Revenue & Orders

	measure 'Category Item Revenue Share %' = DIVIDE([Delivered Item Revenue (BRL)], CALCULATE([Delivered Item Revenue (BRL)], ALL(products_clean[category_name_en])), 0)
		formatString: 0.00%
		displayFolder: 03 Product & Seller

	measure 'Active Delivered Sellers' = CALCULATE(DISTINCTCOUNT(order_items_clean[seller_id]), order_level[is_delivered] = TRUE())
		formatString: #,##0
		displayFolder: 03 Product & Seller

	measure 'Revenue per Active Seller (BRL)' = DIVIDE([Delivered Item Revenue (BRL)], [Active Delivered Sellers], 0)
		formatString: "R$" #,##0.00
		displayFolder: 03 Product & Seller

	column order_id
		dataType: string
		sourceColumn: order_id

	column order_item_id
		dataType: int64
		sourceColumn: order_item_id

	column product_id
		dataType: string
		sourceColumn: product_id

	column seller_id
		dataType: string
		sourceColumn: seller_id

	column shipping_limit_date
		dataType: dateTime
		formatString: yyyy-MM-dd
		sourceColumn: shipping_limit_date

	column price
		dataType: double
		formatString: "R$" #,##0.00
		sourceColumn: price

	column freight_value
		dataType: double
		formatString: "R$" #,##0.00
		sourceColumn: freight_value

	column shipping_limit_outlier
		dataType: boolean
		sourceColumn: shipping_limit_outlier

	column missing_category
		dataType: boolean
		sourceColumn: missing_category

	partition order_items_clean = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\Dell\OneDrive\Desktop\Documents\DataAnalyticsPortfolio\ecommerce-revenue-retention-intelligence\data\processed\order_items_clean.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted,{{"order_id", type text}, {"order_item_id", Int64.Type}, {"product_id", type text}, {"seller_id", type text}, {"shipping_limit_date", type datetime}, {"price", type number}, {"freight_value", type number}, {"shipping_limit_outlier", type logical}, {"missing_category", type logical}}, "en-US")
				in
				    Typed

