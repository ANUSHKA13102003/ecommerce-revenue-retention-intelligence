table sellers_clean

	column seller_id
		dataType: string
		isKey
		sourceColumn: seller_id

	column seller_zip_code_prefix
		dataType: string
		sourceColumn: seller_zip_code_prefix

	column seller_city
		dataType: string
		sourceColumn: seller_city

	column seller_state
		dataType: string
		sourceColumn: seller_state

	column seller_city_normalized
		dataType: string
		sourceColumn: seller_city_normalized

	partition sellers_clean = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\Dell\OneDrive\Desktop\Documents\DataAnalyticsPortfolio\ecommerce-revenue-retention-intelligence\data\processed\sellers_clean.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted,{{"seller_id", type text}, {"seller_zip_code_prefix", type text}, {"seller_city", type text}, {"seller_state", type text}, {"seller_city_normalized", type text}}, "en-US")
				in
				    Typed

