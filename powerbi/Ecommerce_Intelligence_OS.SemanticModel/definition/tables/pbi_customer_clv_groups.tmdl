table pbi_customer_clv_groups
	lineageTag: 2221693b-ac1a-4bf0-b10c-33cf8197a5fd

	measure 'CLV Weighted Avg Order Value Proxy (BRL)' = DIVIDE(SUM(pbi_customer_clv_groups[total_historical_clv_brl]), SUM(pbi_customer_clv_groups[customer_count]), 0)
		formatString: "R$" #,##0.00
		displayFolder: 02 Customer & Retention
		lineageTag: b58badef-91b3-497a-abad-de4ad712b299

	measure 'CLV Weighted Avg Delivered Orders' = DIVIDE(SUM(pbi_customer_clv_groups[total_delivered_orders]), SUM(pbi_customer_clv_groups[customer_count]), 0)
